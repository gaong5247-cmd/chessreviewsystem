{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chess Review System",
  "version": "0.1.0",
  "identifier": "io.nyxen.chessreviewsystem",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Chess Review System", "width": 1510, "height": 920, "minWidth": 1040, "minHeight": 650, "backgroundColor": "#131b24" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/stockfish"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/COPYING"]
  }
}